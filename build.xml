<?xml version="1.0"?>
<project name="tor-binaries" default="checkSignatures">

    <xmlproperty file="pom.xml" prefix="pom"/>
    <property name="torbrowser.version" value="${pom.project.properties.torbrowser.version}"/>
    <property name="torbrowser.download.base.url" value="https://archive.torproject.org/tor-package-archive/torbrowser/${torbrowser.version}"/>
    <property name="pgp.signature.keyserver" value="${pom.project.properties.pgp.signature.keyserver}"/>
    <property name="checksum.file" value="${basedir}/tor-binary-resources/checksums/sha256sums-signed-build.txt"/>
    <property name="checksum.source.url" value="${torbrowser.download.base.url}/sha256sums-signed-build.txt"/>
    <property name="work.directory" value="${basedir}/tmp"/>
    <property name="bundle.directory" value="${work.directory}/bundles"/>
    <property name="verification.keyring.directory" value="${work.directory}/verification-keyring"/>

    <target name="checkSignatures">

        <delete dir="${work.directory}" failonerror="false"/>
        <mkdir dir="${bundle.directory}"/>

        <!-- Checked before the bundles are downloaded: an unauthenticated or outdated
             manifest makes the rest of the run pointless. This call also creates the
             verification keyring that the second call reuses. -->
        <ant antfile="verification.xml" target="verify-checksum-manifest" inheritall="false">
            <property name="checksum.file" value="${checksum.file}"/>
            <property name="checksum.source.url" value="${checksum.source.url}"/>
            <property name="pgp.signature.keyserver" value="${pgp.signature.keyserver}"/>
            <property name="pgp.keyring.directory" value="${verification.keyring.directory}"/>
        </ant>

        <parallel>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-windows-i686-${torbrowser.version}.tar.gz"
                dest="${bundle.directory}/tor-expert-bundle-windows-i686-${torbrowser.version}.tar.gz"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-windows-i686-${torbrowser.version}.tar.gz.asc"
                dest="${bundle.directory}/tor-expert-bundle-windows-i686-${torbrowser.version}.tar.gz.asc"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-windows-x86_64-${torbrowser.version}.tar.gz"
                dest="${bundle.directory}/tor-expert-bundle-windows-x86_64-${torbrowser.version}.tar.gz"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-windows-x86_64-${torbrowser.version}.tar.gz.asc"
                dest="${bundle.directory}/tor-expert-bundle-windows-x86_64-${torbrowser.version}.tar.gz.asc"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-macos-x86_64-${torbrowser.version}.tar.gz"
                dest="${bundle.directory}/tor-expert-bundle-macos-x86_64-${torbrowser.version}.tar.gz"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-macos-x86_64-${torbrowser.version}.tar.gz.asc"
                dest="${bundle.directory}/tor-expert-bundle-macos-x86_64-${torbrowser.version}.tar.gz.asc"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-macos-aarch64-${torbrowser.version}.tar.gz"
                dest="${bundle.directory}/tor-expert-bundle-macos-aarch64-${torbrowser.version}.tar.gz"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-macos-aarch64-${torbrowser.version}.tar.gz.asc"
                dest="${bundle.directory}/tor-expert-bundle-macos-aarch64-${torbrowser.version}.tar.gz.asc"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-linux-i686-${torbrowser.version}.tar.gz"
                dest="${bundle.directory}/tor-expert-bundle-linux-i686-${torbrowser.version}.tar.gz"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-linux-i686-${torbrowser.version}.tar.gz.asc"
                dest="${bundle.directory}/tor-expert-bundle-linux-i686-${torbrowser.version}.tar.gz.asc"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-linux-x86_64-${torbrowser.version}.tar.gz"
                dest="${bundle.directory}/tor-expert-bundle-linux-x86_64-${torbrowser.version}.tar.gz"
                skipexisting="true"/>
            <get
                src="${torbrowser.download.base.url}/tor-expert-bundle-linux-x86_64-${torbrowser.version}.tar.gz.asc"
                dest="${bundle.directory}/tor-expert-bundle-linux-x86_64-${torbrowser.version}.tar.gz.asc"
                skipexisting="true"/>
        </parallel>

        <ant antfile="verification.xml" inheritall="false">
            <target name="verify-bundle-signatures"/>
            <target name="verify-bundle-checksums"/>
            <property name="bundle.directory" value="${bundle.directory}"/>
            <property name="checksum.file" value="${checksum.file}"/>
            <property name="torbrowser.version" value="${torbrowser.version}"/>
            <property name="pgp.signature.keyserver" value="${pgp.signature.keyserver}"/>
            <property name="pgp.keyring.directory" value="${verification.keyring.directory}"/>
            <property name="pgp.keyring.prepared" value="true"/>
        </ant>

        <delete dir="${work.directory}"/>
    </target>
</project>
